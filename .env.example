# ==============================================================================
# Drivique - Variables de Entorno de Base de Datos
# ==============================================================================
# IMPORTANTE: Copia este archivo como '.env' para tu entorno local.
# NUNCA subas archivos .env con credenciales reales a Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PERFIL DESARROLLO (dev - Local con Docker Compose)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drivique_dev
DB_USERNAME=drivique_admin
DB_PASSWORD=drivique_dev_pass

# Credenciales de usuario de aplicación (privilegios mínimos para Spring Boot)
DB_APP_USERNAME=drivique_app
DB_APP_PASSWORD=drivique_app_dev_pass

# ------------------------------------------------------------------------------
# 2. PERFIL QA / STAGING (qa - Gestión exclusiva vía Secretos del Ambiente)
# ------------------------------------------------------------------------------
# En el entorno QA, Spring Boot recibe la URL completa y credenciales como secretos:
# DB_URL=jdbc:postgresql://<qa-host>:5432/drivique_qa?sslmode=require
# DB_USERNAME=<qa_app_user_secret>
# DB_PASSWORD=<qa_app_pass_secret>
# DB_MIGRATOR_USERNAME=<qa_flyway_user_secret>
# DB_MIGRATOR_PASSWORD=<qa_flyway_pass_secret>

# ------------------------------------------------------------------------------
# 3. PERFIL PRODUCCIÓN (main - Gestión exclusiva vía Secretos del Ambiente)
# ------------------------------------------------------------------------------
# En el entorno Main/Producción, los valores se inyectan únicamente mediante Secret Manager:
# DB_URL=jdbc:postgresql://<prod-host>:5432/drivique_prod?sslmode=require
# DB_USERNAME=<prod_app_user_secret>
# DB_PASSWORD=<prod_app_pass_secret>
# DB_MIGRATOR_USERNAME=<prod_flyway_user_secret>
# DB_MIGRATOR_PASSWORD=<prod_flyway_pass_secret>
